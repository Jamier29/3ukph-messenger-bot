# Copy this file to .env for local testing (Render will use its own
# dashboard environment variables instead — see the setup guide).

# A password you make up yourself. You'll enter this same value in the
# Meta App dashboard when setting up the webhook, so Facebook and your
# server can confirm they're talking to each other.
VERIFY_TOKEN=choose-any-random-string-here

# From Meta App dashboard > Messenger > Settings > Access Tokens,
# after generating a token for your 3UK Philippines Page.
PAGE_ACCESS_TOKEN=

# From console.anthropic.com > API Keys.
ANTHROPIC_API_KEY=

# Optional — defaults to claude-haiku-4-5-20251001 if not set.
# CLAUDE_MODEL=claude-haiku-4-5-20251001

PORT=3000
